{
  "name": "cf-workers-sub-next",
  "version": "2.28.2",
  "description": "CF-Workers-SUB-Next V2 - Cloudflare Native 订阅管理与配置生成平台",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --local",
    "build:html": "node scripts/inline-html.js",
    "build": "npm run build:html && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "hono": "^4.13.8",
    "zod": "^3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "@types/node": "^22",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vitest/coverage-v8": "^5",
    "eslint": "^9.39.5",
    "prettier": "^3",
    "typescript": "^5",
    "vite": "^7.3.6",
    "vitest": "^5",
    "wrangler": "^4.136.3",
    "yaml": "^2"
  },
  "overrides": {
    "js-yaml": "^4.3.2"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "workerd@1.20260921.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true
  }
}
